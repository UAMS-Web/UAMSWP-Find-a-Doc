<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        PHPUnit 9 shape for the cannot-run-Pest path (PHP floor below 8.2).

        Two suites, run as two processes (composer test:unit, composer test:integration).
        tests/bootstrap.php boots WordPress only for the Integration suite, so a unit test
        that reaches an unmocked WordPress function fails instead of quietly passing.

        Coverage: PHPUnit 9 uses <coverage><include> (below). PHPUnit 10+ renamed that
        block to <source><include>; when the suite moves to PHPUnit 11 (floor 8.2+),
        rename the element and prefer the Pest templates. Also add failOnEmptyTestSuite
        and defaultTestSuite="Unit" on PHPUnit 10+, which this file omits for 9.x.
    -->
    <testsuites>
        <!-- No WordPress, no database: WordPress functions are mocked with Brain Monkey. -->
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <!-- Boots WordPress through wp-phpunit against the test database. -->
        <testsuite name="Integration">
            <directory suffix="Test.php">./tests/Integration</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">./includes</directory>
            <file>./example-plugin.php</file>
        </include>
    </coverage>
</phpunit>
