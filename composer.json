{
    "name": "uams-web/uamswp-find-a-doc",
    "description": "Development tooling for UAMSWP Find-a-Doc",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "uams-web/patches-patchwork": "^1.0",
        "uams-web/patches-pest-plugin-mutate": "^1.4"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "cweagans/composer-patches": "^2.0",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "6.8",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "cweagans/composer-patches": true
        }
    },
    "scripts": {
        "setup:integration": "@composer install --working-dir=tests/Integration",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": [
            "@test:wiring @no_additional_args",
            "pest"
        ],
        "test:wiring": "pest --ci tests/Wiring/ContentHooksTest.php",
        "test:integration": "@php tests/Integration/vendor/bin/phpunit --configuration tests/Integration/phpunit.xml",
        "mutate": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --path=includes,templates,uamswp-find-a-doc.php,required-plugins.php --ignore=includes/_unused,includes\\_unused tests/Wiring/ContentHooksTest.php tests/Unit"
        ],
        "test:patchwork-lines": "@php scripts/check-patchwork-lines.php",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "setup:integration": "Install the Integration suite's own Composer setup (PHPUnit 9.6, wp-phpunit, the polyfills).",
        "test": "Run both suites, each in its own process, so the Unit suite never sees WordPress.",
        "test:unit": "Run fresh-load wiring and callback tests in separate Pest processes, without WordPress or a database.",
        "test:wiring": "Pin content hooks in a fresh Pest process before any callbacks are loaded.",
        "test:patchwork-lines": "Fail when Patchwork, which the Unit suite loads, changes the line count of a file the mutation run covers, which would credit its coverage to the wrong lines.",
        "mutate": "Run Pest mutation testing over the first-party PHP, naming the wiring test first and then the Unit suite, so the mutants score against the tests that cover them.",
        "test:integration": "Run the PHPUnit 9.6 suite that boots WordPress through wp-phpunit against the test database."
    },
    "autoload-dev": {
        "psr-4": {
            "UamswpFindADoc\\PhpStan\\": "phpstan/",
            "UamswpFindADoc\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "name": "patches-pest-plugin-mutate",
            "type": "vcs",
            "url": "https://github.com/UAMS-Web/patches-pest-plugin-mutate.git"
        },
        {
            "name": "patches-patchwork",
            "type": "vcs",
            "url": "https://github.com/UAMS-Web/patches-patchwork.git"
        }
    ]
}
