{
    "name": "main: required checks (ci-aggregate)",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
        "ref_name": {
            "include": ["~DEFAULT_BRANCH"],
            "exclude": []
        },
        "repository_property": {
            "include": [
                { "name": "required_checks", "source": "custom", "property_values": ["ci-aggregate"] }
            ],
            "exclude": []
        }
    },
    "rules": [
        {
            "type": "required_status_checks",
            "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": false,
                "required_status_checks": [
                    { "context": "CI" }
                ]
            }
        }
    ]
}
