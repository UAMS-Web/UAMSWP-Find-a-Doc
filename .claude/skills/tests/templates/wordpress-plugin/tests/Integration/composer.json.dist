{
    "name": "example/example-plugin-integration-tests",
    "description": "The Integration suite's own Composer setup: WordPress' test suite supports PHPUnit 9 only, and the root runs Pest 5 on PHPUnit 13.",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "~7.1.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
